# Python cache and bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/

# Test and tooling cache
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Runtime state belongs to the consuming repository, never to this source tree.
.ai-memory/

# OS/editor files
.DS_Store
Thumbs.db
.vscode/

# LLM credentials (must NOT be committed). Keep llm_config.example.json as the template.
llm_config.local.json
user_config.local.json
# Remote Memory Hub connection (must NOT be committed). Keep shared_memory.example.json as the template.
shared_memory.local.json
*.api_key
*.apikey
memory_hub/.env
# Read-only dashboard bearer token (must NOT be committed).
memory_hub/.dashboard_token
memory_hub/certs/*
!memory_hub/certs/
!memory_hub/certs/README.md

# Vendored embedding model binaries — too large for plain Git.
# Either pre-stage them locally for `deploy.bat -DownloadModel -ModelOffline`,
# or opt-in via Git LFS (`git lfs track "vendor/models/**"`).
vendor/models/*/*
!vendor/models/README.md
!vendor/models/.gitkeep
