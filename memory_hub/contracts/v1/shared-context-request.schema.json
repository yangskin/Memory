{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shared Context Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["agent_instance_id"],
  "properties": {
    "agent_instance_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string"},
    "include": {
      "type": "array",
      "maxItems": 6,
      "uniqueItems": true,
      "items": {"enum": ["user_brief", "project_brief", "same_task_agents", "my_other_agents", "other_tasks", "project_activity"]}
    },
    "max_age_minutes": {"type": "integer", "minimum": 1, "maximum": 10080},
    "max_items": {"type": "integer", "minimum": 1, "maximum": 20, "default": 10}
  }
}