MEMORY_HUB_ENV=production
# Use the public/NAT IP clients can reach, not the host's Docker bridge IP.
MEMORY_HUB_PUBLIC_IP=203.0.113.10
POSTGRES_PASSWORD=replace-with-a-long-random-password
MEMORY_HUB_LOG_LEVEL=INFO
MEMORY_HUB_DISABLE_DOCS=true

LLM_PROVIDER=fake
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60

BRIEF_USER_DEBOUNCE_SECONDS=20
BRIEF_PROJECT_DEBOUNCE_SECONDS=45
BRIEF_REBASE_INTERVAL_SECONDS=3600