MEMORY_HUB_ENV=production
MEMORY_HUB_DATABASE_URL=postgresql+psycopg://memory_hub:replace-with-a-long-random-password@postgres/memory_hub
# DNS A/AAAA record for this host must point to the server's public IP.
MEMORY_HUB_PUBLIC_HOST=memory.example.com
POSTGRES_PASSWORD=replace-with-a-long-random-password
MEMORY_HUB_LOG_LEVEL=INFO
MEMORY_HUB_DISABLE_DOCS=true

LLM_PROVIDER=fake
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60

BRIEF_USER_DEBOUNCE_SECONDS=20
BRIEF_PROJECT_DEBOUNCE_SECONDS=45
BRIEF_REBASE_INTERVAL_SECONDS=3600