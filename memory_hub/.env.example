MEMORY_HUB_ENV=production
MEMORY_HUB_DATABASE_URL=postgresql+psycopg://memory_hub:replace-with-a-long-random-password@postgres/memory_hub
# DNS A/AAAA record for this host must point to the server's public IP.
MEMORY_HUB_PUBLIC_HOST=memory.example.com
POSTGRES_PASSWORD=replace-with-a-long-random-password
MEMORY_HUB_LOG_LEVEL=INFO
MEMORY_HUB_DISABLE_DOCS=true

LLM_PROVIDER=fake
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60

BRIEF_USER_DEBOUNCE_SECONDS=120
BRIEF_PROJECT_DEBOUNCE_SECONDS=300
BRIEF_REBASE_INTERVAL_SECONDS=21600
# A brief never sends more than this estimated prompt budget or output cap.
BRIEF_PROMPT_TOKEN_BUDGET=6000
BRIEF_OUTPUT_TOKEN_BUDGET=800
# Per-project daily reservation shared by all user and project brief jobs.
BRIEF_DAILY_TOKEN_BUDGET=100000
# Consecutive provider failures before a job is paused until new input arrives.
BRIEF_MAX_ATTEMPTS=5