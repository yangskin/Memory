https://{$MEMORY_HUB_PUBLIC_HOST} {
	# Certificate and private key are mounted read-only from ./certs.
	tls /etc/caddy/certs/fullchain.pem /etc/caddy/certs/privkey.pem
	request_body {
		max_size 1MB
	}
	reverse_proxy api:8000 {
		transport http {
			read_timeout 65s
			write_timeout 65s
		}
	}
	header {
		Strict-Transport-Security "max-age=31536000"
	}
}
