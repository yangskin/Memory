FROM node:22-bookworm-slim AS node
FROM python:3.11-slim
COPY --from=node /usr/local/bin/node /usr/local/bin/node
WORKDIR /workspace
COPY requirements.txt ./
COPY memory_hub/pyproject.toml memory_hub/README.md ./memory_hub/
COPY memory_hub/src ./memory_hub/src
ARG PIP_INDEX_URL=https://pypi.org/simple
RUN pip install --no-cache-dir --index-url "$PIP_INDEX_URL" -r requirements.txt './memory_hub[dev]'
COPY servers ./servers
COPY vendor ./vendor
COPY scripts/Resolve-MemoryTestPython.ps1 ./scripts/Resolve-MemoryTestPython.ps1
COPY memory_hub ./memory_hub
ENV PYTHONPATH=/workspace/memory_hub/src:/workspace \
    PYTHONDONTWRITEBYTECODE=1
WORKDIR /workspace/memory_hub
CMD ["sh", "-c", "alembic upgrade head && python -m pytest tests -ra -p no:cacheprovider --junitxml=/tmp/hub-tests.xml"]
